# Copie para .env.local e preencha. Nunca versione o .env.local.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Chave secreta (service_role). Só no servidor: usada apenas para excluir a conta do usuário (LGPD).
# Sem ela, o botão "Excluir minha conta" mostra um aviso em vez de excluir.
SUPABASE_SERVICE_ROLE_KEY=

# E-mail de contato de privacidade exibido no app e na Política de privacidade (LGPD).
NEXT_PUBLIC_PRIVACY_EMAIL=
